# npm run setup genera .env; completa la conexión con tu servidor MySQL.
PORT=8080
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cana_dulce
DB_USER=cana_dulce_app
DB_PASSWORD=
# En la nube usa TLS y, cuando corresponda, el certificado CA del proveedor.
DB_SSL=false
# DB_SSL_CA_PATH=C:/ruta/ca.pem
# DB_SSL_CA=certificado PEM; también admite saltos de línea escapados.
DOCENTE_USUARIO=docente
DOCENTE_PASSWORD_HASH=GENERAR_CON_NPM_RUN_SETUP
JWT_SECRET=GENERAR_CON_NPM_RUN_SETUP
