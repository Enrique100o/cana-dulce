{
  "name": "cana-dulce-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de comprensión lectora para la Institución Educativa Caña Dulce",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
