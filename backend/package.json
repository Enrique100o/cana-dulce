{
  "name": "cana-dulce-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de comprensión lectora para la Institución Educativa Caña Dulce",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "setup": "node scripts/configurar.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "db:init": "node --env-file-if-exists=.env scripts/inicializar.mjs",
    "db:import": "node --env-file-if-exists=.env scripts/migrar-sqlite.mjs",
    "seed": "node --env-file-if-exists=.env scripts/sembrar.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "3.24.6"
  }
}
